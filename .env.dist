# - - - - - TELEGRAM BOT SETTINGS - - - - - #

# Localization languages. Avoid spaces between entries. The order determines language priority.
# For the full list of locales, refer to aiogram_bot_template/enums/locale.py
TELEGRAM_LOCALES=uk,ru,en

# Telegram bot token, obtainable via https://t.me/BotFather
TELEGRAM_BOT_TOKEN=42:ABC

# Drop old updates when the bot was inactive (True/False)
TELEGRAM_DROP_PENDING_UPDATES=False

# Webhook configuration
TELEGRAM_USE_WEBHOOK=True
TELEGRAM_RESET_WEBHOOK=True
TELEGRAM_WEBHOOK_PATH=/telegram
TELEGRAM_WEBHOOK_SECRET=123456abcdef
TELEGRAM_MINIAPP_AUTH_MAX_AGE_SECONDS=86400
TELEGRAM_MINIAPP_SESSION_TTL_SECONDS=86400

# Telegram gifts delivery (userbot / MTProto)
TELEGRAM_GIFTS_USERBOT_API_ID=
TELEGRAM_GIFTS_USERBOT_API_HASH=
TELEGRAM_GIFTS_USERBOT_SESSION=
TELEGRAM_GIFTS_USERBOT_DEVICE_MODEL=TTStars Gifts Userbot
TELEGRAM_GIFTS_USERBOT_SYSTEM_VERSION=Linux
TELEGRAM_GIFTS_USERBOT_APP_VERSION=TTStars/1.0
TELEGRAM_GIFTS_USERBOT_LANG_CODE=en
TELEGRAM_GIFTS_USERBOT_SYSTEM_LANG_CODE=en

# - - - - - PAYMENTS SETTINGS - - - - - #

# Crypto Pay (CryptoBot) payments
CRYPTO_PAY_API_TOKEN=
CRYPTO_PAY_BASE_URL=https://pay.crypt.bot/api
CRYPTO_PAY_CURRENCY_TYPE=fiat
CRYPTO_PAY_FIAT=USD
# Leave empty to allow all supported assets in CryptoBot invoice.
CRYPTO_PAY_ACCEPTED_ASSETS=
CRYPTO_PAY_WEBHOOK_PATH=/crypto-pay/webhook
CRYPTO_PAY_FEE_PERCENT=3
CRYPTO_PAY_MIN_PAYMENT_USD=1
CRYPTO_PAY_PAYOUT_FEE_PERCENT=0
CRYPTO_PAY_PAYOUT_FIXED_USD=0

# TON payments
TON_PAY_TONAPI_BASE_URL=https://tonapi.io
TON_PAY_TONAPI_API_KEY=
TON_PAY_INVOICE_API_KEY=
TON_PAY_INVOICE_BASE_URL=https://tonconsole.com
TON_PAY_INVOICE_WEBHOOK_PATH=/ton-pay/webhook
TON_PAY_INVOICE_LIFETIME_SECONDS=1800
TON_PAY_INVOICE_CURRENCY=TON
TON_PAY_INVOICE_STATUS_CACHE_TTL_SECONDS=5
TON_PAY_INVOICE_TX_SCAN_LIMIT=50
TON_PAY_RATE_CACHE_TTL_SECONDS=30
TON_PAY_FEE_PERCENT=1
TON_PAY_MIN_PAYMENT_USD=1
TON_PAY_PAYOUT_FEE_PERCENT=0
TON_PAY_PAYOUT_FIXED_USD=0

# Platega payments (SBP QR)
PLATEGA_PAY_MERCHANT_ID=
PLATEGA_PAY_SECRET_KEY=
PLATEGA_PAY_BASE_URL=https://app.platega.io
PLATEGA_PAY_CURRENCY=RUB
PLATEGA_PAY_METHOD=2
# Optional fixed USD -> provider currency rate. Leave empty to fetch a cached public rate.
PLATEGA_PAY_USD_TO_CURRENCY_RATE=
PLATEGA_PAY_WEBHOOK_PATH=/platega-pay/webhook
PLATEGA_PAY_SUCCESS_URL=https://t.me/your_bot_username
PLATEGA_PAY_FAIL_URL=https://t.me/your_bot_username
PLATEGA_PAY_FEE_PERCENT=0
PLATEGA_PAY_MIN_PAYMENT_USD=1
PLATEGA_PAY_MIN_TOPUP_USD=1
PLATEGA_PAY_PAYOUT_FEE_PERCENT=0
PLATEGA_PAY_PAYOUT_FIXED_USD=0

# LZT Market payments
LZT_PAY_API_TOKEN=
LZT_PAY_BASE_URL=https://prod-api.lzt.market
LZT_PAY_MERCHANT_ID=
LZT_PAY_MERCHANT_KEY=
LZT_PAY_CURRENCY=usd
LZT_PAY_WEBHOOK_PATH=/lzt-pay/webhook
LZT_PAY_SUCCESS_URL=https://t.me/your_bot_username
LZT_PAY_FEE_PERCENT=0
LZT_PAY_MIN_PAYMENT_USD=1
LZT_PAY_PAYOUT_FEE_PERCENT=0
LZT_PAY_PAYOUT_FIXED_USD=0

# NicePay payments (RU/KZ cards)
NICE_PAY_MERCHANT_ID=
NICE_PAY_SECRET_KEY=
NICE_PAY_BASE_URL=https://nicepay.io
NICE_PAY_CURRENCY_RU=RUB
NICE_PAY_CURRENCY_KZ=KZT
NICE_PAY_METHOD=
NICE_PAY_WEBHOOK_PATH=/nice-pay/webhook
NICE_PAY_SUCCESS_URL=https://t.me/your_bot_username
NICE_PAY_FAIL_URL=https://t.me/your_bot_username
NICE_PAY_FEE_PERCENT_RU=9
NICE_PAY_FEE_PERCENT_KZ=9
NICE_PAY_MIN_PAYMENT_USD_RU=1
NICE_PAY_MIN_PAYMENT_USD_KZ=1
NICE_PAY_PAYOUT_FEE_PERCENT=5.5
NICE_PAY_PAYOUT_FIXED_USD=0

# xRocket Pay payments
XROCKET_PAY_API_KEY=
XROCKET_PAY_BASE_URL=https://pay.xrocket.exchange
XROCKET_PAY_CURRENCY=USDT
XROCKET_PAY_WEBHOOK_PATH=/xrocket-pay/webhook
XROCKET_PAY_SUCCESS_URL=https://t.me/your_bot_username
XROCKET_PAY_FEE_PERCENT=0
XROCKET_PAY_MIN_PAYMENT_USD=1
XROCKET_PAY_PAYOUT_FEE_PERCENT=0
XROCKET_PAY_PAYOUT_FIXED_USD=0

# Heleket Pay payments
HELEKET_PAY_MERCHANT_ID=
HELEKET_PAY_API_KEY=
HELEKET_PAY_BASE_URL=https://api.heleket.com
HELEKET_PAY_CURRENCY=USD
HELEKET_PAY_TO_CURRENCY=
HELEKET_PAY_NETWORK=
HELEKET_PAY_WEBHOOK_PATH=/heleket-pay/webhook
HELEKET_PAY_RETURN_URL=https://t.me/your_bot_username
HELEKET_PAY_SUCCESS_URL=https://t.me/your_bot_username
HELEKET_PAY_CALLBACK_URL=
# Optional webhook hardening:
# Comma-separated IP/CIDR whitelist. Heleket docs currently mention: 31.133.220.8
HELEKET_PAY_WEBHOOK_TRUSTED_IPS=
# Trust X-Forwarded-For instead of direct peer IP (enable when behind reverse proxy)
HELEKET_PAY_WEBHOOK_TRUST_FORWARDED_IP=false
HELEKET_PAY_LIFETIME_SECONDS=3600
HELEKET_PAY_IS_PAYMENT_MULTIPLE=true
HELEKET_PAY_SUBTRACT_PERCENT=0
HELEKET_PAY_FEE_PERCENT=2
HELEKET_PAY_MIN_PAYMENT_USD=1
HELEKET_PAY_PAYOUT_FEE_PERCENT=0
HELEKET_PAY_PAYOUT_FIXED_USD=0

PAYMENTS_REFERRAL_LEVEL1_PERCENT=2
PAYMENTS_REFERRAL_LEVEL2_PERCENT=1
PAYMENTS_REFERRAL_LEVEL3_PERCENT=0.5
PAYMENTS_POLL_INTERVAL_SECONDS=20
PAYMENTS_POLL_BATCH_SIZE=200
PAYMENTS_POLL_CONCURRENCY=8
PAYMENTS_STARS_SELL_USD_PER_STAR=0.012
PAYMENTS_STARS_SELL_HOLD_DAYS=21
PAYMENTS_STARS_SELL_MIN_STARS=50
PAYMENTS_STARS_SELL_MAX_STARS=25000

# - - - - - POSTGRESQL SETTINGS - - - - - #

# Host (default is the Docker container name)
POSTGRES_HOST=postgres

# Database password
POSTGRES_PASSWORD=my_pg_password

# Database name
POSTGRES_DB=my_db_name

# Port (default: 5432)
POSTGRES_PORT=5432

# Username
POSTGRES_USER=my_pg_user

# Path to PostgreSQL data for Docker volumes
POSTGRES_DATA=/var/lib/postgresql/data

# - - - - - SQLALCHEMY SETTINGS - - - - - #
ALCHEMY_ECHO=False
ALCHEMY_ECHO_POOL=False
ALCHEMY_POOL_SIZE=25
ALCHEMY_MAX_OVERFLOW=50
ALCHEMY_POOL_TIMEOUT=10
ALCHEMY_POOL_RECYCLE=3600

# - - - - - REDIS SETTINGS - - - - - #

# Host (default is the Docker container name)
REDIS_HOST=redis

# Port (default: 6379)
REDIS_PORT=6379

# Database (0 if using only a single database)
REDIS_DB=0

# Redis password
REDIS_PASSWORD=12345abcdef

# Path to Redis data for Docker volumes
REDIS_DATA=/redis_data

# - - - - - SERVER SETTINGS - - - - - #
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_URL=https://trolololo.icu

# - - - - - OTHER SETTINGS - - - - - #

# Bot admin chat id.
# Used for admin commands in package "bot/handlers/admin" package.
# Both private and group chats are allowed.
COMMON_ADMIN_CHAT_ID=5945468457
COMMON_ADMIN_PANEL_ENABLED=false
COMMON_ADMIN_PANEL_PATH=/admin
COMMON_ADMIN_PANEL_USERNAME=admin
COMMON_ADMIN_PANEL_PASSWORD=change_me
# Optional. If empty, TELEGRAM_WEBHOOK_SECRET is used for session signing.
COMMON_ADMIN_PANEL_SESSION_SECRET=
COMMON_ADMIN_PANEL_SESSION_TTL_SECONDS=43200

# - - - - - FRAGMENT DELIVERY SETTINGS - - - - - #
#
# Cookies from authenticated Fragment session.
# Supports two formats:
# 1) cookie header string: key=value; key2=value2; ...
# 2) JSON object string with keys: stel_ssid, stel_dt, stel_token, stel_ton_token
FRAGMENT_COOKIES=
#
# Optional static hash override (normally auto-fetched from Fragment stars page)
FRAGMENT_HASH=
#
# TON wallet credentials used to pay Fragment checkout transactions
FRAGMENT_WALLET_API_KEY=
# 24-word mnemonic separated by spaces
FRAGMENT_WALLET_MNEMONIC=
# Wallet contract version used to sign transactions: V4R2 or V5R1
FRAGMENT_WALLET_VERSION=V5R1
